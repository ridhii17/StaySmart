<link rel="stylesheet" href="/css/navbar.css" />

<nav class="navbar navbar-expand-md sticky-top app-navbar">
  <div class="container-fluid app-navbar__inner">
    <a class="navbar-brand app-brand" href="/listings" aria-label="StaySphere home">
      <span class="app-brand__mark"><i class="fa-solid fa-house-chimney-window"></i></span>
      <span>StaySphere</span>
    </a>

    <button
      class="navbar-toggler"
      type="button"
      data-bs-toggle="collapse"
      data-bs-target="#navbarNavAltMarkup"
      aria-controls="navbarNavAltMarkup"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <ul class="navbar-nav align-items-md-center nav-grid">
        <li class="nav-item nav-explore">
          <a class="nav-link" href="/listings">Explore stays</a>
        </li>

        <li class="nav-item nav-center">
          <form action="/listings/search" method="get" id="searchBox" role="search">
            <input
              class="form-control search-input"
              type="search"
              name="q"
              placeholder="Where would you like to go?"
              aria-label="Search stays by destination"
            />
            <button class="btn search-btn" type="submit" aria-label="Search">
              <i class="fa-solid fa-magnifying-glass"></i>
              <span class="search-text">Search</span>
            </button>
          </form>
        </li>

        <li class="nav-item nav-right">
          <div class="nav-right-links">
            <a class="nav-link nav-host-link" href="/listings/new">Become a host</a>
            <% if (currentUser) { %>
              <a class="nav-link" href="/profile">Profile</a>
              <a class="nav-link nav-auth-link" href="/logout">Log out</a>
            <% } else { %>
              <a class="nav-link" href="/login">Log in</a>
              <a class="nav-link nav-signup-link" href="/signup">Sign up</a>
            <% } %>
          </div>
        </li>
      </ul>
    </div>
  </div>
</nav>

<script src="/js/navbar.js"></script>
