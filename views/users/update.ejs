<% layout("/layouts/boilerplate") %>
<link rel="stylesheet" href="/css/account-settings.css" />

<%
  const accountPhoto = user.image?.url || "/Icon/DefaultImg.png";
%>

<main class="account-settings-page">
  <a class="settings-back-link" href="/profile"><i class="fa-solid fa-arrow-left"></i> Back to Profile</a>
  <header class="settings-heading">
    <p class="settings-eyebrow">ACCOUNT SETTINGS</p>
    <h1>Manage your account</h1>
    <p>Update your profile details, password, or photo.</p>
  </header>

  <div class="settings-layout">
    <nav class="settings-tabs" role="tablist" aria-label="Account settings">
      <button class="settings-tab is-active" type="button" role="tab" id="detailsTab" aria-controls="detailsPanel" aria-selected="true" data-settings-tab="detailsPanel"><i class="fa-regular fa-user"></i> Profile details</button>
      <% if (!user.providerId) { %><button class="settings-tab" type="button" role="tab" id="passwordTab" aria-controls="passwordPanel" aria-selected="false" data-settings-tab="passwordPanel"><i class="fa-solid fa-lock"></i> Password</button><% } %>
      <button class="settings-tab" type="button" role="tab" id="imageTab" aria-controls="imagePanel" aria-selected="false" data-settings-tab="imagePanel"><i class="fa-regular fa-image"></i> Profile photo</button>
    </nav>

    <div class="settings-panels">
      <section class="settings-panel" id="detailsPanel" role="tabpanel" aria-labelledby="detailsTab">
        <div class="settings-panel-heading"><span class="settings-panel-icon"><i class="fa-regular fa-id-card"></i></span><div><h2>Profile details</h2><p>Keep your account information up to date.</p></div></div>
        <form action="/update-account/<%= user._id %>" method="POST" class="settings-form needs-validation" novalidate>
          <div class="settings-field-row">
            <label>First name<input type="text" name="fName" value="<%= user.fName || '' %>" autocomplete="given-name" required /></label>
            <label>Last name<input type="text" name="lName" value="<%= user.lName || '' %>" autocomplete="family-name" /></label>
          </div>
          <label>Username<input type="text" name="username" value="<%= user.username || '' %>" autocomplete="username" required /></label>
          <label>Email address<input type="email" name="email" value="<%= user.email || '' %>" autocomplete="email" required /></label>
          <div class="settings-form-actions"><a class="settings-cancel" href="/profile">Cancel</a><button type="submit" class="smart-button">Save changes</button></div>
        </form>
      </section>

      <% if (!user.providerId) { %>
        <section class="settings-panel" id="passwordPanel" role="tabpanel" aria-labelledby="passwordTab" hidden>
          <div class="settings-panel-heading"><span class="settings-panel-icon"><i class="fa-solid fa-lock"></i></span><div><h2>Change password</h2><p>Choose a new password you haven’t used before.</p></div></div>
          <form action="/update-password/<%= user._id %>" method="POST" class="settings-form needs-validation" novalidate>
            <label>Current password<input type="password" name="oldPassword" autocomplete="current-password" minlength="8" required /></label>
            <label>New password<input type="password" name="newPassword" autocomplete="new-password" minlength="8" required /></label>
            <div class="settings-form-actions"><a class="settings-cancel" href="/profile">Cancel</a><button type="submit" class="smart-button">Update password</button></div>
          </form>
        </section>
      <% } %>

      <section class="settings-panel" id="imagePanel" role="tabpanel" aria-labelledby="imageTab" hidden>
        <div class="settings-panel-heading"><span class="settings-panel-icon"><i class="fa-regular fa-image"></i></span><div><h2>Profile photo</h2><p>Choose a clear image so hosts and guests can recognize you.</p></div></div>
        <form action="/update-image/<%= user._id %>" method="POST" class="settings-form needs-validation" enctype="multipart/form-data" novalidate>
          <div class="settings-photo-current"><img src="<%= accountPhoto %>" alt="Current profile photo" onerror="this.onerror=null;this.src='/Icon/DefaultImg.png';"/><span>Current photo</span></div>
          <label>Choose a new photo<input type="file" name="image" accept="image/*" id="verify-img" required onchange="previewImage()" /></label>
          <div id="imagePreview" class="settings-photo-preview"><span>Your new photo preview will appear here.</span></div>
          <div class="settings-form-actions"><a class="settings-cancel" href="/profile">Cancel</a><button type="submit" class="smart-button">Save photo</button></div>
        </form>
      </section>
    </div>
  </div>
</main>

<script src="/js/image-preview.js"></script>
<script src="/js/update.js"></script>
