<% layout("/layouts/boilerplate") %>
<link rel="stylesheet" href="/css/features.css" />
<main class="smart-page smart-narrow"><header class="smart-hero"><div><p class="smart-eyebrow">PRICE REVIEW</p><h1>Review your trip</h1><p>Transparent demo checkout · no payment is collected.</p></div></header>
  <div class="booking-layout"><section class="smart-panel"><h2><%= listing.title %></h2><p><%= new Date(booking.checkIn).toLocaleDateString("en-IN", { day:"numeric", month:"short", year:"numeric" }) %> – <%= new Date(booking.checkOut).toLocaleDateString("en-IN", { day:"numeric", month:"short", year:"numeric" }) %> · <%= booking.guests %> guests</p><dl class="price-breakdown"><div><dt>₹<%= Number(listing.price).toLocaleString("en-IN") %> × <%= booking.price.nights %> nights</dt><dd>₹<%= booking.price.subtotal.toLocaleString("en-IN") %></dd></div><div><dt>Service fee (8%)</dt><dd>₹<%= booking.price.serviceFee.toLocaleString("en-IN") %></dd></div><div><dt>Cleaning fee (5% of one night)</dt><dd>₹<%= booking.price.cleaningFee.toLocaleString("en-IN") %></dd></div><div class="price-breakdown__total"><dt>Total</dt><dd>₹<%= booking.price.total.toLocaleString("en-IN") %></dd></div><div><dt>Per person</dt><dd>₹<%= perPerson.toLocaleString("en-IN") %></dd></div></dl><form action="/bookings/confirm" method="POST"><button class="smart-button smart-button--wide">Confirm demo reservation</button></form><p class="smart-muted">This confirmation simulates a completed reservation; it does not charge a card.</p></section><aside class="smart-panel booking-preview"><img src="<%= listing.image?.url || '/Icon/listing-img-pre.png' %>" alt="<%= listing.title %>"/><p class="smart-eyebrow">YOUR PLACE</p><h2><%= [listing.location, listing.country].filter(Boolean).join(", ") %></h2><p><%= listing.capacity || 2 %> guest capacity · <%= listing.propertyType || "Home" %></p></aside></div>
</main>
