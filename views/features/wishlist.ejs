<% layout("/layouts/boilerplate") %>
<link rel="stylesheet" href="/css/features.css" />
<link rel="stylesheet" href="/css/dashboard-suite.css" />
<main class="smart-page suite-page wishlist-dashboard">
  <header class="smart-hero suite-hero"><div><p class="smart-eyebrow">YOUR SHORTLIST</p><h1>A few good options, ready when you are.</h1><p>Keep places you love together, compare the details, then book when the time feels right.</p></div><div class="suite-hero__actions"><a class="smart-button smart-button--light" href="/listings"><i class="fa-solid fa-compass"></i> Explore stays</a><a class="smart-button suite-button--white" href="/compare"><i class="fa-solid fa-code-compare"></i> Compare places</a></div></header>
  <section class="suite-content-panel"><header class="suite-content-heading"><div><p class="smart-eyebrow">SAVED FOR LATER</p><h2>Your shortlist</h2><p><%= listings.length %> places saved to your travel collection.</p></div><span class="suite-count"><i class="fa-regular fa-heart"></i> <%= listings.length %> saved</span></header>
    <% if (listings.length) { %><div class="smart-grid"><% for (const item of listings) { %><%- include("stay-card.ejs", { listing: item.listing, trustScore: item.trustScore }) %><% } %></div><% } else { %><div class="suite-empty"><span><i class="fa-regular fa-heart"></i></span><h3>Start a shortlist for your next escape</h3><p>Tap the heart on a place to save it here, then compare your favorites side by side.</p><a class="smart-button" href="/listings">Explore places</a></div><% } %>
  </section>
</main>
