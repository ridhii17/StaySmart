<% layout("/layouts/boilerplate") %>
<link rel="stylesheet" href="/css/features.css" />
<link rel="stylesheet" href="/css/dashboard-suite.css" />
<% const travelerTotal = trips.reduce((sum, trip) => sum + Number(trip.travelerCount || 0), 0); const budgetTotal = trips.reduce((sum, trip) => sum + Number(trip.budget || 0), 0); const staysTotal = trips.reduce((sum, trip) => sum + (trip.selectedListings?.length || 0), 0); %>
<main class="smart-page suite-page group-dashboard">
  <header class="smart-hero suite-hero"><div><p class="smart-eyebrow">GROUP TRIP WORKSPACE</p><h1>Good trips are better planned together.</h1><p>Bring stay options, shared spending, group size, and budget into a single trip plan.</p></div><div class="suite-hero__actions"><a class="smart-button suite-button--white" href="/trips/new"><i class="fa-solid fa-plus"></i> Plan a trip</a></div></header>
  <section class="suite-metrics" aria-label="Group plan summary">
    <article><span class="suite-metric-icon suite-metric-icon--teal"><i class="fa-solid fa-map-location-dot"></i></span><div><small>Trip plans</small><strong><%= trips.length %></strong><span>your travel workspace</span></div></article>
    <article><span class="suite-metric-icon suite-metric-icon--blue"><i class="fa-solid fa-user-group"></i></span><div><small>Travelers planned</small><strong><%= travelerTotal %></strong><span>across your groups</span></div></article>
    <article><span class="suite-metric-icon suite-metric-icon--gold"><i class="fa-solid fa-wallet"></i></span><div><small>Combined budgets</small><strong>₹<%= budgetTotal.toLocaleString("en-IN") %></strong><span>across all plans</span></div></article>
    <article><span class="suite-metric-icon suite-metric-icon--violet"><i class="fa-regular fa-bookmark"></i></span><div><small>Saved stay options</small><strong><%= staysTotal %></strong><span>ready for comparison</span></div></article>
  </section>
  <section class="suite-content-panel"><header class="suite-content-heading"><div><p class="smart-eyebrow">YOUR PLANS</p><h2>Trips in progress</h2><p>Open a plan to compare stays and settle shared costs.</p></div><span class="suite-count"><%= trips.length %> total</span></header>
    <% if (trips.length) { %><div class="smart-grid smart-grid--trip"><% for (const trip of trips) { %><a class="smart-trip-card" href="/trips/<%= trip._id %>"><p class="smart-eyebrow"><%= trip.studentMode ? "STUDENT MODE" : "GROUP PLAN" %> · <%= trip.destination %></p><h2><%= trip.name %></h2><% if (trip.startDate && trip.endDate) { %><p><i class="fa-regular fa-calendar"></i> <%= trip.startDate.toLocaleDateString("en-IN", {day:"numeric",month:"short"}) %> – <%= trip.endDate.toLocaleDateString("en-IN", {day:"numeric",month:"short",year:"numeric"}) %></p><% } else { %><p><i class="fa-regular fa-calendar"></i> Travel dates not set</p><% } %><div class="suite-trip-meta"><span><i class="fa-solid fa-user-group"></i> <strong><%= trip.travelerCount %></strong> travelers</span><span><i class="fa-solid fa-indian-rupee-sign"></i> <strong><%= Number(trip.budget).toLocaleString("en-IN") %></strong> budget</span><span><i class="fa-regular fa-bookmark"></i> <strong><%= trip.selectedListings?.length || 0 %></strong> stays</span></div></a><% } %></div><% } else { %><div class="suite-empty"><span><i class="fa-solid fa-people-group"></i></span><h3>Start planning your next group trip</h3><p>Set your destination, travelers, dates, and budget. Then shortlist places and track shared expenses together.</p><a class="smart-button" href="/trips/new">Create your first plan</a></div><% } %>
  </section>
</main>
