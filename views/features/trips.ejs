<% layout("/layouts/boilerplate") %>
<link rel="stylesheet" href="/css/features.css" />
<main class="smart-page"><header class="smart-hero"><div><p class="smart-eyebrow">GROUP TRIP PLANNER</p><h1>Plan together.</h1><p>Compare stay costs, track the shared budget, and keep group expenses in one place.</p></div><a class="smart-button" href="/trips/new"><i class="fa-solid fa-plus"></i> Plan a trip</a></header>
  <% if (trips.length) { %><div class="smart-grid smart-grid--trip"><% for (const trip of trips) { %><a class="smart-trip-card" href="/trips/<%= trip._id %>"><p class="smart-eyebrow"><%= trip.studentMode ? "STUDENT MODE" : "GROUP PLAN" %></p><h2><%= trip.name %></h2><p><i class="fa-solid fa-location-dot"></i> <%= trip.destination %></p><div><span><strong><%= trip.travelerCount %></strong> travelers</span><span><strong>₹<%= Number(trip.budget).toLocaleString("en-IN") %></strong> budget</span></div></a><% } %></div><% } else { %><div class="smart-empty"><h2>Start planning your next group trip</h2><p>Set a destination, group size, travel dates, and a budget to see stay estimates per person.</p><a class="smart-button" href="/trips/new">Create a group plan</a></div><% } %>
</main>
