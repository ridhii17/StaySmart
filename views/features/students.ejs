<% layout("/layouts/boilerplate") %>
<link rel="stylesheet" href="/css/features.css" />
<link rel="stylesheet" href="/css/dashboard-suite.css" />
<main class="smart-page suite-page student-dashboard"><header class="smart-hero suite-hero"><div><p class="smart-eyebrow">STUDENT MODE</p><h1>Make your budget go further.</h1><p>Affordable stays for study breaks, internships, and group travel. Compare Wi-Fi, kitchen and transport details when hosts provide them.</p></div></header>
  <form class="smart-search-panel smart-search-panel--compact" action="/students" method="GET"><label>Maximum nightly price (₹)<input type="number" name="maxPrice" min="0" value="<%= maxPrice %>" /></label><fieldset class="student-amenity-filters"><legend>Prioritize facilities</legend><% for (const amenity of studentAmenities) { %><label><input type="checkbox" name="amenities" value="<%= amenity %>" <%= selectedAmenities.includes(amenity) ? "checked" : "" %> /> <%= amenity %></label><% } %></fieldset><button class="smart-button">Update search</button></form>
  <div class="student-amenity-note"><strong>Student essentials</strong><span><%= studentAmenities.join(" · ") %></span><small>Host-provided amenity details are shown on each place page.</small></div>
  <% if (listings.length) { %><div class="smart-grid"><% for (const item of listings) { %><%- include("stay-card.ejs", { listing: item.listing, trustScore: item.trustScore }) %><% } %></div><% } else { %><div class="smart-empty"><h2>No stays fit that price yet</h2><p>Try raising your nightly limit or changing the destination.</p><a class="smart-button" href="/listings">Browse all stays</a></div><% } %>
</main>
