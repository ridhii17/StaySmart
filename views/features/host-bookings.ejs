<% layout("/layouts/boilerplate") %>
<link rel="stylesheet" href="/css/features.css" />
<main class="smart-page"><header class="smart-hero"><div><p class="smart-eyebrow">HOST DASHBOARD</p><h1>Reservations for your places</h1><p>See guest dates, party size, status and reservation totals.</p></div><a class="smart-button smart-button--outline" href="/profile">Back to dashboard</a></header>
  <% if (bookings.length) { %><div class="smart-booking-list"><% for (const booking of bookings) { %><article class="smart-booking"><img src="<%= booking.listing?.image?.url || '/Icon/listing-img-pre.png' %>" alt="<%= booking.listing?.title || 'Place' %>"/><div class="smart-booking__body"><p class="smart-eyebrow"><%= booking.status %> · <%= booking.listing?.title || "Place unavailable" %></p><h2><%= booking.guest?.fName || booking.guest?.username || "Guest" %></h2><p><%= booking.guest?.email || "" %></p><p><%= booking.checkIn.toLocaleDateString("en-IN") %> – <%= booking.checkOut.toLocaleDateString("en-IN") %> · <%= booking.guests %> guests</p><strong>₹<%= booking.total.toLocaleString("en-IN") %></strong></div></article><% } %></div><% } else { %><div class="smart-empty"><h2>No reservations yet</h2><p>Confirmed guest reservations for your places will appear here.</p><a class="smart-button" href="/listings/new">Add a place</a></div><% } %>
</main>
