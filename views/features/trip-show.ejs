<% layout("/layouts/boilerplate") %>
<link rel="stylesheet" href="/css/features.css" />
<main class="smart-page"><a class="smart-back" href="/trips">← All trip plans</a><header class="smart-hero"><div><p class="smart-eyebrow"><%= trip.studentMode ? "STUDENT MODE · " : "GROUP TRIP · " %><%= trip.destination %></p><h1><%= trip.name %></h1><p><%= trip.travelerCount %> travelers · <%= duration %> night estimate · Group budget ₹<%= Number(trip.budget).toLocaleString("en-IN") %></p></div><a class="smart-button smart-button--outline" href="/smart-picks?destination=<%= encodeURIComponent(trip.destination) %>&guests=<%= trip.travelerCount %>&budget=<%= Math.floor(trip.budget / Math.max(duration,1)) %>">Smart recommendations</a></header>
  <section class="trip-summary-grid"><article><span>Group budget</span><strong>₹<%= Number(trip.budget).toLocaleString("en-IN") %></strong><small>₹<%= Math.ceil(trip.budget / trip.travelerCount).toLocaleString("en-IN") %> per person</small></article><article><span>Stay estimate (lowest option)</span><strong>₹<%= Number(accommodation).toLocaleString("en-IN") %></strong><small>Across <%= savedStays.length %> saved option(s)</small></article><article><span>Shared expenses</span><strong>₹<%= Number(spent).toLocaleString("en-IN") %></strong></article><article class="<%= remaining < 0 ? 'is-over-budget' : '' %>"><span><%= remaining < 0 ? "Over budget by" : "Remaining budget" %></span><strong>₹<%= Math.abs(Number(remaining)).toLocaleString("en-IN") %></strong></article></section>
  <% if (remaining < 0) { %><div class="budget-alert"><i class="fa-solid fa-triangle-exclamation"></i> This trip is over budget. Review lower-priced alternatives or your expense plan.</div><% } %>
  <section class="smart-section"><div class="smart-section-heading"><div><p class="smart-eyebrow">STAY COMPARISON</p><h2>Accommodation options</h2><p>Estimates include service and cleaning fees for <%= duration %> night(s), divided across the group.</p></div><% if (savedStays.length) { const compareIds = savedStays.map(item => item._id).join(","); %><a class="smart-button smart-button--outline" href="/compare?ids=<%= compareIds %>">Compare saved stays</a><% } %></div>
    <% if (accommodationOptions.length) { %><div class="smart-grid"> <% for (const estimate of accommodationOptions) { const place = estimate.listing; const total = estimate.total; %><article class="smart-card"><a href="/listings/<%= place._id %>" class="smart-card__photo"><img src="<%= place.image?.url || '/Icon/listing-img-pre.png' %>" alt="<%= place.title %>"/><span class="smart-card__score">₹<%= total.toLocaleString("en-IN") %> estimated stay</span></a><div class="smart-card__body"><p class="smart-muted"><%= [place.location,place.country].filter(Boolean).join(", ") %></p><h3><%= place.title %></h3><p class="smart-price">₹<%= Math.ceil(total / trip.travelerCount).toLocaleString("en-IN") %> <small>/ person</small></p><form method="POST" action="/trips/<%= trip._id %>/stays/<%= place._id %>?_method=DELETE"><button class="smart-button smart-button--outline">Remove option</button></form></div></article><% } %></div><% } else { %><p class="smart-empty">No stay options saved. Add one below to compare group costs.</p><% } %>
    <% if (listings.length) { %><div class="trip-suggestions"><h3>Places in <%= trip.destination %></h3><div class="trip-suggestion-list"><% for (const place of listings) { %><div><span><strong><%= place.title %></strong><small><%= [place.location,place.country].filter(Boolean).join(", ") %> · ₹<%= Number(place.price).toLocaleString("en-IN") %>/night · up to <%= place.capacity || 2 %></small></span><form method="POST" action="/trips/<%= trip._id %>/stays"><input type="hidden" name="listingId" value="<%= place._id %>"/><button class="smart-button smart-button--outline">Add option</button></form></div><% } %></div></div><% } %>
  </section>
  <section class="smart-section"><div class="smart-section-heading"><div><p class="smart-eyebrow">SHARED COSTS</p><h2>Expense manager</h2><p>Record who paid and split each expense across selected members.</p></div></div>
    <div class="trip-expense-layout"><form class="smart-panel smart-form" method="POST" action="/trips/<%= trip._id %>/expenses"><h3>Add an expense</h3><label>Expense name<input name="label" maxlength="100" placeholder="Train tickets" required /></label><div class="smart-form-row"><label>Amount (₹)<input type="number" name="amount" min="0.01" step="0.01" required /></label><label>Category<select name="category"><option value="accommodation">Accommodation</option><option value="food">Food</option><option value="transport">Transport</option><option value="activities">Activities</option><option value="other">Other</option></select></label></div><label>Paid by<select name="payer" required><% for (const person of trip.participants) { %><option><%= person %></option><% } %></select></label><fieldset class="split-members"><legend>Split between</legend><% for (const person of trip.participants) { %><label><input type="checkbox" name="splitBetween" value="<%= person %>" checked /> <%= person %></label><% } %></fieldset><button class="smart-button">Add expense</button></form>
      <div class="smart-panel"><h3>Expense ledger</h3><% if (trip.expenses.length) { %><div class="expense-list"><% for (const expense of trip.expenses) { %><article><div><strong><%= expense.label %></strong><small><%= expense.category %> · <%= expense.payer %> paid · split with <%= (expense.splitBetween || []).join(", ") || "group" %></small></div><strong>₹<%= Number(expense.amount).toLocaleString("en-IN") %></strong><form method="POST" action="/trips/<%= trip._id %>/expenses/<%= expense._id %>?_method=DELETE"><button aria-label="Remove expense" class="expense-remove">×</button></form></article><% } %></div><% } else { %><p class="smart-muted">Your shared costs will appear here.</p><% } %><hr/><h4>Expense balances</h4><div class="settlement-list"><% for (const person of trip.participants) { %><p><span><%= person %></span><strong class="<%= balances[person] >= 0 ? 'balance-positive' : 'balance-negative' %>"><%= balances[person] >= 0 ? 'to receive ' : 'owes ' %>₹<%= Math.abs(balances[person]).toFixed(0) %></strong></p><% } %></div><h4>Suggested pending payments</h4><% if (settlements.length) { %><div class="settlement-list"><% for (const settlement of settlements) { %><p><span><%= settlement.from %> pays <%= settlement.to %></span><strong>₹<%= settlement.amount.toFixed(2) %></strong></p><% } %></div><% } else { %><p class="smart-muted">No pending payments from recorded expenses.</p><% } %><small>Transfers are calculated from each expense’s payer and split members; StaySmart does not move money.</small></div></div>
  </section>
</main>
