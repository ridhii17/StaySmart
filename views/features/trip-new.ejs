<% layout("/layouts/boilerplate") %>
<link rel="stylesheet" href="/css/features.css" />
<main class="smart-page smart-narrow"><header class="smart-hero"><div><p class="smart-eyebrow">GROUP TRIP PLANNER</p><h1>Build your trip plan</h1><p>Add the basics first. You can compare places and record group expenses next.</p></div></header>
  <form class="smart-panel smart-form" action="/trips" method="POST"><label>Trip name<input name="name" maxlength="100" placeholder="Long weekend in Jaipur" /></label><label>Destination<input name="destination" maxlength="100" placeholder="Jaipur" required /></label><div class="smart-form-row"><label>Travelers<input type="number" name="travelerCount" min="1" max="30" value="2" required /></label><label>Total group budget (₹)<input type="number" name="budget" min="0" step="100" value="20000" required /></label></div><div class="smart-form-row"><label>Start date<input type="date" name="startDate" /></label><label>End date<input type="date" name="endDate" /></label></div><label>Group members <small>(comma-separated names)</small><input name="participants" placeholder="Ridhi, Aanya, Dev" /></label><label class="smart-check"><input type="checkbox" name="studentMode" /> Enable Student Mode recommendations</label><button class="smart-button">Create trip plan</button></form>
</main>
