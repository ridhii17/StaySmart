<% layout("/layouts/boilerplate") %>
<link rel="stylesheet" href="/css/property-form.css" />

<main class="property-form-page">
  <header class="property-form-heading">
    <p class="property-form-eyebrow">HOST WITH STAYSPHERE</p>
    <h1>Share your place with travelers</h1>
    <p>Introduce your space, add a few helpful details, and get it ready to welcome guests.</p>
  </header>

  <form
    method="POST"
    action="/listings"
    novalidate
    class="needs-validation property-form"
    enctype="multipart/form-data"
  >
    <section class="property-form-section">
      <div class="property-form-section__heading">
        <span class="property-form-step">01</span>
        <div>
          <h2>Tell us about your place</h2>
          <p>Give guests a clear first impression.</p>
        </div>
      </div>

      <div class="property-field">
        <label for="title" class="form-label">Property name</label>
        <input
          id="title"
          name="listing[title]"
          placeholder="e.g., Courtyard Suite in Jaipur"
          type="text"
          class="form-control"
          required
        />
        <div class="valid-feedback">That name looks good.</div>
      </div>

      <div class="property-field">
        <label for="category" class="form-label">Stay category</label>
        <select
          id="category"
          name="listing[category]"
          class="form-select"
          required
        >
          <option value="" disabled selected>Choose a category</option>
          <option value="Trending">Trending</option>
          <option value="Rooms">Rooms</option>
          <option value="Iconic Cities">Iconic Cities</option>
          <option value="Mountains">Mountains</option>
          <option value="Castles">Castles</option>
          <option value="Amazing pools">Amazing pools</option>
          <option value="Camping">Camping</option>
          <option value="Farms">Farms</option>
          <option value="Arctic">Arctic</option>
          <option value="Domes">Domes</option>
          <option value="Boats">Boats</option>
        </select>
        <small class="property-field__hint">Choose the collection that best describes your place.</small>
      </div>

      <div class="property-field">
        <label for="description" class="form-label">About this place</label>
        <textarea
          id="description"
          name="listing[description]"
          class="form-control"
          placeholder="Describe the space, what guests will love, and anything useful to know before they arrive."
          rows="5"
          required
        ></textarea>
        <div class="invalid-feedback">Add a short description of your place.</div>
      </div>
    </section>

    <section class="property-form-section">
      <div class="property-form-section__heading">
        <span class="property-form-step">02</span>
        <div>
          <h2>Add a cover photo</h2>
          <p>Choose a bright, clear photo that shows the space at its best.</p>
        </div>
      </div>

      <div class="property-field">
        <label for="verify-img" class="form-label">Cover photo</label>
        <input
          id="verify-img"
          name="listing[image]"
          type="file"
          accept="image/*"
          class="form-control"
          onchange="previewImage()"
          required
        />
        <div id="imagePreview" class="property-photo-preview mt-3">
          <span>Choose a photo to preview it here.</span>
        </div>
      </div>
    </section>

    <section class="property-form-section property-form-section--last">
      <div class="property-form-section__heading">
        <span class="property-form-step">03</span>
        <div>
          <h2>Set the location and rate</h2>
          <p>Help travelers find your place and understand the nightly price.</p>
        </div>
      </div>

      <div class="property-form-row property-form-row--price">
        <div class="property-field">
          <label for="price" class="form-label">Price per night</label>
          <div class="input-group">
            <span class="input-group-text">₹</span>
            <input
              id="price"
              name="listing[price]"
              type="number"
              min="1"
              step="1"
              placeholder="1200"
              class="form-control"
              required
            />
          </div>
        </div>

        <div class="property-field">
          <label for="country" class="form-label">Country</label>
          <input
            id="country"
            name="listing[country]"
            placeholder="India"
            type="text"
            class="form-control"
            required
          />
        </div>
      </div>

      <div class="property-field">
        <label for="location" class="form-label">City or neighborhood</label>
        <input
          id="location"
          name="listing[location]"
          placeholder="Jaipur, Rajasthan"
          type="text"
          class="form-control"
          required
        />
      </div>
    </section>

    <div class="property-form-actions">
      <p>Your place will appear in Explore once it’s published.</p>
      <button type="submit" class="property-form-submit">
        Publish place <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      </button>
    </div>
  </form>
</main>

<script src="/js/newImg-size.js"></script>
<script src="/js/image-preview.js"></script>
