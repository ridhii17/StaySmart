<% layout("/layouts/boilerplate") %>
<link rel="stylesheet" href="/css/property-form.css" />

<%
  const selectedCategory = Array.isArray(listing.category)
    ? listing.category[0]
    : listing.category;
%>

<main class="property-form-page">
  <header class="property-form-heading">
    <p class="property-form-eyebrow">YOUR SPACE</p>
    <h1>Update your place</h1>
    <p>Keep the details and photos up to date for your future guests.</p>
  </header>

  <form
    method="POST"
    action="/listings/<%= listing.id %>?_method=PUT"
    novalidate
    class="needs-validation property-form"
    enctype="multipart/form-data"
  >
    <section class="property-form-section">
      <div class="property-form-section__heading">
        <span class="property-form-step">01</span>
        <div>
          <h2>Place details</h2>
          <p>Make sure your description is clear and current.</p>
        </div>
      </div>

      <div class="property-field">
        <label for="title" class="form-label">Property name</label>
        <input
          id="title"
          name="listing[title]"
          value="<%= listing.title %>"
          type="text"
          class="form-control"
          required
        />
        <div class="valid-feedback">That name looks good.</div>
      </div>

      <div class="property-field">
        <label for="category" class="form-label">Stay category</label>
        <select id="category" name="listing[category]" class="form-select" required>
          <option value="" disabled <%= selectedCategory ? "" : "selected" %>>Choose a category</option>
          <option value="Trending" <%= selectedCategory === "Trending" ? "selected" : "" %>>Trending</option>
          <option value="Rooms" <%= selectedCategory === "Rooms" ? "selected" : "" %>>Rooms</option>
          <option value="Iconic Cities" <%= selectedCategory === "Iconic Cities" ? "selected" : "" %>>Iconic Cities</option>
          <option value="Mountains" <%= selectedCategory === "Mountains" ? "selected" : "" %>>Mountains</option>
          <option value="Castles" <%= selectedCategory === "Castles" ? "selected" : "" %>>Castles</option>
          <option value="Amazing pools" <%= selectedCategory === "Amazing pools" ? "selected" : "" %>>Amazing pools</option>
          <option value="Camping" <%= selectedCategory === "Camping" ? "selected" : "" %>>Camping</option>
          <option value="Farms" <%= selectedCategory === "Farms" ? "selected" : "" %>>Farms</option>
          <option value="Arctic" <%= selectedCategory === "Arctic" ? "selected" : "" %>>Arctic</option>
          <option value="Domes" <%= selectedCategory === "Domes" ? "selected" : "" %>>Domes</option>
          <option value="Boats" <%= selectedCategory === "Boats" ? "selected" : "" %>>Boats</option>
        </select>
        <small class="property-field__hint">Choose the collection that best describes your place.</small>
      </div>

      <div class="property-field">
        <label for="description" class="form-label">About this place</label>
        <textarea
          id="description"
          name="listing[description]"
          class="form-control"
          rows="5"
          required
        ><%= listing.description %></textarea>
        <div class="invalid-feedback">Add a short description of your place.</div>
      </div>
    </section>

    <section class="property-form-section">
      <div class="property-form-section__heading">
        <span class="property-form-step">02</span>
        <div>
          <h2>Photos</h2>
          <p>Keep your cover photo fresh and representative of the space.</p>
        </div>
      </div>

      <div class="property-photo-current">
        <span class="property-photo-label">Current cover photo</span>
        <img
          src="<%= originalImageUrl %>"
          alt="Current photo of <%= listing.title %>"
          onerror="this.onerror=null;this.src='/Icon/listing-img-pre.png';"
        />
      </div>

      <div class="property-field">
        <label for="verify-img" class="form-label">Replace cover photo <span>(optional)</span></label>
        <input
          id="verify-img"
          name="listing[image]"
          type="file"
          accept="image/*"
          class="form-control"
          onchange="previewImage()"
        />
        <small class="property-field__hint">Leave this empty to keep the current photo.</small>
        <p id="errorContainer" class="property-field__error"></p>
      </div>

      <div class="property-field">
        <label class="form-label" for="imagePreview">New photo preview</label>
        <div id="imagePreview" class="property-photo-preview">
          <span>Choose a new photo to preview it here.</span>
        </div>
      </div>

      <label class="property-confirm-photo" for="verify">
        <input type="checkbox" checked id="verify" required />
        <span>I have permission to use any photo I upload.</span>
      </label>
    </section>

    <section class="property-form-section property-form-section--last">
      <div class="property-form-section__heading">
        <span class="property-form-step">03</span>
        <div>
          <h2>Location and rate</h2>
          <p>Help guests find you and understand the nightly price.</p>
        </div>
      </div>

      <div class="property-form-row property-form-row--price">
        <div class="property-field">
          <label for="price" class="form-label">Price per night</label>
          <div class="input-group">
            <span class="input-group-text">₹</span>
            <input
              id="price"
              type="number"
              min="1"
              step="1"
              value="<%= listing.price %>"
              name="listing[price]"
              class="form-control"
              required
            />
          </div>
        </div>
        <div class="property-field">
          <label for="country" class="form-label">Country</label>
          <input
            id="country"
            type="text"
            value="<%= listing.country %>"
            name="listing[country]"
            class="form-control"
            required
          />
        </div>
      </div>

      <div class="property-field">
        <label for="location" class="form-label">City or neighborhood</label>
        <input
          id="location"
          name="listing[location]"
          value="<%= listing.location %>"
          type="text"
          class="form-control"
          required
        />
      </div>
    </section>

    <div class="property-form-actions">
      <p>Your updates will appear on your StaySphere page.</p>
      <button type="submit" class="property-form-submit">
        Save changes <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
      </button>
    </div>
  </form>
</main>

<script src="/js/editImg-size.js"></script>
<script src="/js/image-preview.js"></script>
